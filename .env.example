# Postgres connection string (Neon). The app connects over Neon's WebSocket
# driver rather than a raw TCP pool, so use the UNPOOLED connection string
# here (no "-pooler" in the hostname) — it works for both schema pushes and
# normal app queries without needing a second DIRECT_URL.
#
# Find it on Vercel: Project -> Storage -> your Postgres database -> ".env.local"
# tab -> the line starting with DATABASE_URL_UNPOOLED (copy that value here).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Postgres connection string. In production this is set for you when you
# connect a database from the Vercel project's Storage tab (Postgres/Neon).
# For local development, copy this file to .env and paste your own connection
# string (e.g. from the same Vercel Storage tab, or any Postgres instance).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
